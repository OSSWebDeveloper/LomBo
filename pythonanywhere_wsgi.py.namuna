# PythonAnywhere WSGI fayli — MRClayd hisobi uchun tayyor namuna.
#
# Bu faylni PythonAnywhere'ga YUKLAMAYSIZ. Uning mazmunini serverdagi
#     /var/www/mrclayd_pythonanywhere_com_wsgi.py
# faylining ichiga nusxalaysiz (Web bo'limidagi "WSGI configuration file"
# havolasi orqali ochiladi) va eski mazmunini butunlay o'chirib tashlaysiz.
#
# MAXFIY KALIT: pastdagi LOMBARD_SECRET_KEY qiymatini serverning o'zida yasang:
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Chiqqan satrni shu faylga qo'yasiz. Kalitni boshqa hech qayerga nusxalamang.

import os
import sys

path = '/home/MRClayd/lombard_site'
if path not in sys.path:
    sys.path.insert(0, path)

# --- Sozlamalar (get_wsgi_application'dan OLDIN berilishi shart) ---
os.environ['LOMBARD_DEBUG'] = '0'
os.environ['LOMBARD_HOSTS'] = 'mrclayd.pythonanywhere.com'
os.environ['LOMBARD_SECRET_KEY'] = 'SHU-YERGA-SERVERDA-YASAGAN-KALIT'

os.environ['DJANGO_SETTINGS_MODULE'] = 'config.settings'

from django.core.wsgi import get_wsgi_application  # noqa: E402

application = get_wsgi_application()
